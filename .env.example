# Opção gratuita: chave do Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=
# Opcional: modelo Gemini (padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Opção paga (mais precisa): chave da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Se as duas chaves existirem, escolha: gemini ou anthropic (padrão: gemini)
AI_PROVIDER=gemini
# Opcional: pedidos por minuto por IP
EASIER_RATE_LIMIT=12
