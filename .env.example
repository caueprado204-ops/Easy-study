# Opção gratuita: chave do Google AI Studio (aistudio.google.com → Get API key)
GEMINI_API_KEY=
# Opcional: modelo Gemini (padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Segunda opção gratuita: Groq (console.groq.com → API Keys). Entra quando o Gemini estiver sem cota.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Grok, da xAI (pago; console.x.ai → API Keys)
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Opção paga (mais precisa): chave da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ordem de uso das IAs; a próxima entra quando a anterior falha ou fica sem cota
AI_PROVIDER=gemini,groq,grok,anthropic
# Opcional: pedidos por minuto por IP
EASIER_RATE_LIMIT=12

# Contas e limites por plano (Supabase → Project Settings → API Keys)
SUPABASE_URL=https://gqncndoiuitharlgrznr.supabase.co
SUPABASE_SECRET_KEY=
# Opcional: deixa a busca de videoaulas mais estável (YouTube Data API v3)
YOUTUBE_API_KEY=
